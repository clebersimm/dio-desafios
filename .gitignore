# Ignore build outputs
bin/
obj/
*.exe
*.dll
*.pdb
*.cache
*.log

# Ignore user-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Ignore VS Code settings
.vscode/

# Ignore Rider settings
.idea/

# Ignore test results
TestResults/

# Ignore NuGet packages
*.nupkg
packages/
*.snupkg

# Ignore publish outputs
publish/
out/

# Ignore temporary files
*.tmp
*.bak

# Ignore database files
*.mdf
*.ldf

# Ignore coverage results
coverage/
*.coverage
*.coveragexml

# Ignore other non-source files
*.db
*.DS_Store
*.swp

# Allow source files
!*.cs
!*.csproj
!*.sln
!*.config
!*.json
!*.xml